rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isResponsible() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/responsaveis/1)
        && request.auth.token.email
          == get(/databases/$(database)/documents/responsaveis/1).data.email;
    }

    function currentStudentId() {
      return get(
        /databases/$(database)/documents/alunos/$(request.auth.uid)
      ).data.id_aluno;
    }

    function studentOwns(data) {
      return signedIn() && currentStudentId() == data.id_aluno;
    }

    match /alunos/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isResponsible();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'id_aluno',
          'nome_completo',
          'cpf',
          'senha_hash',
          'nome_preferido',
          'data_criacao'
        ])
        && request.resource.data.keys().hasOnly([
          'id_aluno',
          'nome_completo',
          'cpf',
          'senha_hash',
          'nome_preferido',
          'data_criacao'
        ])
        && request.resource.data.cpf.matches('^[0-9]{11}$')
        && request.auth.token.email
          == request.resource.data.cpf + '@aluno.ser.app'
        && request.resource.data.data_criacao == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['nome_preferido'])
        && request.resource.data.nome_preferido is string
        && request.resource.data.nome_preferido.size() <= 40;

      allow delete: if false;
    }

    match /responsaveis/{id} {
      allow read: if isResponsible();

      allow create: if signedIn()
        && id == '1'
        && request.auth.token.email != null
        && request.resource.data.email == request.auth.token.email;

      allow update, delete: if false;
    }

    match /horarios_disponiveis/{id} {
      allow read: if signedIn();

      allow create, delete: if isResponsible();

      allow update: if isResponsible()
        || (
          signedIn()
          && resource.data.disponivel == true
          && request.resource.data.disponivel == false
          && request.resource.data.id_agendamento is int
          && getAfter(
            /databases/$(database)/documents/agendamentos/$(request.resource.data.id_agendamento)
          ).data.id_aluno == currentStudentId()
          && getAfter(
            /databases/$(database)/documents/agendamentos/$(request.resource.data.id_agendamento)
          ).data.status == 'agendado'
        )
        || (
          signedIn()
          && resource.data.id_agendamento is int
          && get(
            /databases/$(database)/documents/agendamentos/$(resource.data.id_agendamento)
          ).data.id_aluno == currentStudentId()
          && request.resource.data.disponivel == true
          && request.resource.data.id_agendamento == null
          && getAfter(
            /databases/$(database)/documents/agendamentos/$(resource.data.id_agendamento)
          ).data.status == 'cancelado'
        )
        || (
          signedIn()
          && resource.data.id_agendamento is int
          && get(
            /databases/$(database)/documents/agendamentos/$(resource.data.id_agendamento)
          ).data.id_aluno == currentStudentId()
          && request.resource.data.disponivel == true
          && request.resource.data.id_agendamento == null
          && (
            getAfter(
              /databases/$(database)/documents/agendamentos/$(resource.data.id_agendamento)
            ).data.status == 'cancelado'
            || getAfter(
              /databases/$(database)/documents/agendamentos/$(resource.data.id_agendamento)
            ).data.data != resource.data.data
            || getAfter(
              /databases/$(database)/documents/agendamentos/$(resource.data.id_agendamento)
            ).data.horario != resource.data.horario
          )
        );
    }

    match /agendamentos/{id} {
      allow get: if isResponsible() || studentOwns(resource.data);
      allow list: if isResponsible() || studentOwns(resource.data);

      allow create: if isResponsible()
        || (
          signedIn()
          && currentStudentId() == request.resource.data.id_aluno
          && request.resource.data.status == 'agendado'
        );

      allow update: if isResponsible()
        || (
          studentOwns(resource.data)
          && request.resource.data.id_aluno == resource.data.id_aluno
          && request.resource.data.id_responsavel == resource.data.id_responsavel
          && request.resource.data.id_agendamento == resource.data.id_agendamento
          && request.resource.data.data_criacao == resource.data.data_criacao
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'data', 'horario'])
        );

      allow delete: if isResponsible();
    }

    match /atendimentos/{id} {
      allow read, write: if isResponsible();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
