rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isStudent(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isResponsible() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email
          == get(
            /databases/$(database)/documents/responsaveis/1
          ).data.email;
    }

    // =========================
    // ALUNOS
    // =========================

    match /alunos/{uid} {

      allow read: if isStudent(uid);

      allow create: if isStudent(uid)
        && request.resource.data.keys().hasAll([
          'nome_completo',
          'cpf',
          'nome_preferido',
          'data_criacao'
        ])
        && request.resource.data.keys().hasOnly([
          'nome_completo',
          'cpf',
          'nome_preferido',
          'data_criacao'
        ])
        && request.resource.data.cpf.matches('^[0-9]{11}$')
        && request.auth.token.email
          == request.resource.data.cpf + '@aluno.ser.app'
        && request.resource.data.data_criacao == request.time;

      allow update: if isStudent(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['nome_preferido'])
        && request.resource.data.nome_preferido is string
        && request.resource.data.nome_preferido.size() > 0
        && request.resource.data.nome_preferido.size() <= 40;

      allow delete: if false;
    }


    // =========================
    // RESPONSÁVEL
    // =========================

    match /responsaveis/{id} {

      allow read: if isResponsible();

      allow create, update, delete: if false;
    }


    // =========================
    // AGENDAMENTOS
    // =========================

    match /agendamentos/{id} {

      allow read, write: if signedIn();
    }


    // =========================
    // HORÁRIOS DISPONÍVEIS
    // =========================

    match /horarios_disponiveis/{id} {

      allow read: if signedIn();

      allow create, update, delete: if isResponsible();
    }


    // =========================
    // ATENDIMENTOS
    // =========================

    match /atendimentos/{id} {

      // Atendimento e resumo pertencem ao responsável.
      allow read, write: if isResponsible();
    }


    // =========================
    // BLOQUEIO PADRÃO
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}